# VERITAS configuration — copy to .env for local development.
# Placeholders only. Never commit a real .env. Every setting fails closed when unset.

# Runtime environment: development | test | production (default: production).
VERITAS_ENVIRONMENT=development

# Must stay false outside local debugging; refused in production.
VERITAS_DEBUG=false

# restricted: operational case access requires a provisioned authenticated identity.
# demo: anonymous READ-ONLY access to synthetic cases flagged as demonstrations.
#       Development/test only: production requires restricted and refuses demo mode.
VERITAS_ACCESS_MODE=demo

# Reverse-proxy source IPs/CIDRs trusted to set X-Real-IP (leave empty unless configured).
# VERITAS_TRUSTED_PROXY_IPS=10.0.0.5,10.0.1.0/24

# Server-side session lifetime and failed-login lockout policy.
VERITAS_SESSION_TTL_MINUTES=720
VERITAS_LOGIN_FAILURE_LIMIT=5
VERITAS_LOGIN_LOCKOUT_MINUTES=15

# PostgreSQL connection URL. Keep credentials out of this URL; supply PGPASSWORD
# separately for local backend runs (Compose wires it from POSTGRES_PASSWORD).
VERITAS_DATABASE_URL=postgresql+psycopg://veritas@127.0.0.1:5432/veritas

# Host headers the API accepts (comma-separated; '*' is refused in production).
VERITAS_ALLOWED_HOSTS=localhost,127.0.0.1

# Browser origins allowed to call the API directly. Empty = none (the frontend is
# served from the same origin through a proxy, so none are needed by default).
VERITAS_CORS_ORIGINS=

# Maximum accepted ordinary request body size in bytes.
VERITAS_MAX_REQUEST_BYTES=1048576

# Private backend-only storage root and bounded raw EvidenceObject upload size.
# Docker Compose overrides the storage root to /var/lib/veritas/evidence and persists it
# in the backend-only evidencedata volume. The Nginx upload ceiling is 100 MiB.
VERITAS_EVIDENCE_STORAGE_ROOT=./data/evidence
VERITAS_MAX_EVIDENCE_BYTES=104857600

# V2.3 examination worker (database-backed, in-process; no external queue). A RUNNING run whose
# heartbeat is older than the stale threshold is returned to the queue. The stale threshold must
# be at least three times the heartbeat interval. Defaults shown; usually left unset.
# VERITAS_EXAMINATION_WORKER_ENABLED=true
# VERITAS_EXAMINATION_POLL_SECONDS=1.0
# VERITAS_EXAMINATION_HEARTBEAT_SECONDS=2.0
# VERITAS_EXAMINATION_STALE_SECONDS=30.0

# DEBUG | INFO | WARNING | ERROR
VERITAS_LOG_LEVEL=INFO

# Serve /docs and /openapi.json (never served in production regardless).
VERITAS_EXPOSE_API_DOCS=false

# --- Frontend development server (read by frontend/vite.config.ts only) ---
# Where the dev server proxies /api, /health and /ready.
VERITAS_API_PROXY_TARGET=http://127.0.0.1:8000
# Extra hostnames allowed to reach the dev server (comma-separated), e.g. a tunnel domain.
VERITAS_DEV_ALLOWED_HOSTS=

# --- Docker Compose only ---
# Password for the compose-managed PostgreSQL container. Set in your local .env.
POSTGRES_PASSWORD=CHANGE_ME
