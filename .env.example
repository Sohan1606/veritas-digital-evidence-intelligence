# VERITAS configuration — copy to .env for local development.
# Placeholders only. Never commit a real .env. Every setting fails closed when unset.

# Runtime environment: development | test | production (default: production).
VERITAS_ENVIRONMENT=development

# Must stay false outside local debugging; refused in production.
VERITAS_DEBUG=false

# restricted (default): no identity provider exists in V1, so no case data is served.
# demo: anonymous READ-ONLY access to cases flagged as demonstration data only.
VERITAS_ACCESS_MODE=demo

# PostgreSQL connection. Replace the placeholder password locally; never reuse it.
VERITAS_DATABASE_URL=postgresql+psycopg://veritas:CHANGE_ME@127.0.0.1:5432/veritas

# Host headers the API accepts (comma-separated; '*' is refused in production).
VERITAS_ALLOWED_HOSTS=localhost,127.0.0.1

# Browser origins allowed to call the API directly. Empty = none (the frontend is
# served from the same origin through a proxy, so none are needed by default).
VERITAS_CORS_ORIGINS=

# Maximum accepted request body size in bytes (the V1 API is read-only).
VERITAS_MAX_REQUEST_BYTES=1048576

# DEBUG | INFO | WARNING | ERROR
VERITAS_LOG_LEVEL=INFO

# Serve /docs and /openapi.json (never served in production regardless).
VERITAS_EXPOSE_API_DOCS=false

# --- Frontend development server (read by frontend/vite.config.ts only) ---
# Where the dev server proxies /api, /health and /ready.
VERITAS_API_PROXY_TARGET=http://127.0.0.1:8000
# Extra hostnames allowed to reach the dev server (comma-separated), e.g. a tunnel domain.
VERITAS_DEV_ALLOWED_HOSTS=

# --- Docker Compose only ---
# Password for the compose-managed PostgreSQL container. Set in your local .env.
POSTGRES_PASSWORD=CHANGE_ME
